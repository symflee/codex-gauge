root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,m,h}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,plist,entitlements,xcconfig}]
indent_style = space
indent_size = 2

[*.pbxproj]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
